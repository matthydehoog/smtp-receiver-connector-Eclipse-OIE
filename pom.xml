<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.matthy.oie</groupId>
  <artifactId>smtp-receiver-connector</artifactId>
  <version>1.0.2</version>
  <packaging>jar</packaging>

  <name>OIE SMTP Receiver Connector</name>
  <description>
    Source connector for Eclipse Open Integration Engine that runs an SMTP server: mail sent to it
    is handed to the channel as an RFC 822 message (or as JSON).
  </description>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Must match the engine you deploy to (see the README of the repository). -->
    <oie.version>4.6.0</oie.version>
  </properties>

  <dependencies>
    <!-- Engine jars, installed into the local repository from <OIE_HOME> (see README). -->
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>server-api</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>donkey-server</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>donkey-model</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>client</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>client-core</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Already on the engine's classpath. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>2.20.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.14.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.miglayout</groupId>
      <artifactId>miglayout-swing</artifactId>
      <version>4.2</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test only: a real SMTP client to test the server with. The engine itself does not need them. -->
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
      <version>2.1.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>2.0.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- The engine wants three separate jars: shared (properties), server (receiver), client (Swing panel). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>shared-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>shared</classifier>
              <includes><include>com/mirth/connect/connectors/smtpreceiver/shared/**</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>server-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>server</classifier>
              <includes><include>com/mirth/connect/connectors/smtpreceiver/server/**</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>client-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>client</classifier>
              <includes><include>com/mirth/connect/connectors/smtpreceiver/client/**</include></includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <descriptors>
            <descriptor>assembly.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
