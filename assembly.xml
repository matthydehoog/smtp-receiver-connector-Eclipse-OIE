<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
  <id>extension</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>smtp-receiver</baseDirectory>

  <files>
    <file>
      <source>src/main/resources/source.xml</source>
      <outputDirectory>/</outputDirectory>
    </file>
    <file>
      <source>${project.build.directory}/${project.build.finalName}-shared.jar</source>
      <outputDirectory>/</outputDirectory>
      <destName>smtpreceiver-shared.jar</destName>
    </file>
    <file>
      <source>${project.build.directory}/${project.build.finalName}-server.jar</source>
      <outputDirectory>/</outputDirectory>
      <destName>smtpreceiver-server.jar</destName>
    </file>
    <file>
      <source>${project.build.directory}/${project.build.finalName}-client.jar</source>
      <outputDirectory>/</outputDirectory>
      <destName>smtpreceiver-client.jar</destName>
    </file>
  </files>

  <fileSets>
    <!-- Plugin for the web administrator (oie-web-client) -->
    <fileSet>
      <directory>webadmin</directory>
      <outputDirectory>/webadmin</outputDirectory>
    </fileSet>
  </fileSets>

</assembly>
